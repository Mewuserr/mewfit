{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mewfit",
  // ล็อกบัญชีไว้ — บัญชี Cloudflare ของ m3wxuser@gmail.com (คนละบัญชีกับ ALTF4/FanQuiz)
  "account_id": "784ec89cbd9ffe6aa24ef5158cea48be",
  "compatibility_date": "2026-09-30",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // บัญชีผู้ใช้ + ข้อมูลที่ซิงก์ · ใช้ `npx wrangler d1 migrations apply mewfit --remote` ก่อน deploy เมื่อมี migration ใหม่
  "d1_databases": [
    { "binding": "DB", "database_name": "mewfit", "database_id": "efc71c8d-5694-4b0d-8872-f0abe968baf3", "migrations_dir": "migrations" }
  ],
  // แจ้งเตือนบนมือถือ: ตรวจตารางทุก 5 นาที · คีย์ลับ VAPID_PRIVATE ตั้งด้วย `npx wrangler secret put VAPID_PRIVATE`
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "VAPID_PUBLIC": "BJHrvKL0vH-kkQ3dRKgR0HZkF23wb-53V4IlUXsvpd07a0XChw5uCQrE9Bo3J_NsD3DGktaY3z7o0ZEHgS46icY" },
  "observability": { "enabled": true }
}
